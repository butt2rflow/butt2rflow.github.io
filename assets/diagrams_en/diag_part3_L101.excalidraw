    {
      "type": "text",
      "id": "text2",
      "x": 169,
      "y": 261.5,
      "width": 402,
      "height": 137,
      "text": "Case (2): Compound investor\n• Reinvest all winnings into the next spin\n• A long-term investor compounding gains\n\n→ Pick the wheel with the highest geometric mean: #1!\n (#1: 1.26 > #3: 0.89 > #2: 0.00)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
