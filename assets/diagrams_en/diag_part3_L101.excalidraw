    {
      "type": "text",
      "id": "text1",
      "x": 169,
      "y": 81.5,
      "width": 402,
      "height": 137,
      "text": "Case (1): Simple-interest investor\n• Spin once a day with $1 fresh, return any profit\n• Or \"just one shot\" with part of your wealth\n\n→ Pick the wheel with the highest arithmetic mean: #3!\n (#3: 1.77 > #2: 1.33 > #1: 1.30)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 976817,
      "version": 1,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "originalText": "Case (1): Simple-interest investor\n• Spin once a day with $1 fresh, return any profit\n• Or \"just one shot\" with part of your wealth\n\n→ Pick the wheel with the highest arithmetic mean: #3!\n (#3: 1.77 > #2: 1.33 > #1: 1.30)"
    },
