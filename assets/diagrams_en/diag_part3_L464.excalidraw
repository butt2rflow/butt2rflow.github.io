    {
      "type": "text",
      "id": "el0556_3559",
      "x": 115.0,
      "y": 80.0,
      "width": 510.0,
      "height": 120,
      "text": "Example 1: Win 70%, +50% on win, –80% on loss\n\np = 0.70, q = 0.30, b = 0.50, a = 0.80\nf* = 0.70/0.80 – 0.30/0.50 = 0.875 – 0.600 = 0.275\n→ Bet 27.5% of wealth [OK] (positive, favorable game)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#16a34a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 903571,
      "version": 1,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "baseline": 16,
      "originalText": "Example 1: Win 70%, +50% on win, –80% on loss\n\np = 0.70, q = 0.30, b = 0.50, a = 0.80\nf* = 0.70/0.80 – 0.30/0.50 = 0.875 – 0.600 = 0.275\n→ Bet 27.5% of wealth [OK] (positive, favorable game)"
    },
