    {
      "type": "text",
      "id": "el0558_5970",
      "x": 110.1,
      "y": 250.0,
      "width": 519.8,
      "height": 140,
      "text": "Example 2: Win 70%, +50% on win, –200% on loss (2× leverage!)\n\np = 0.70, q = 0.30, b = 0.50, a = 2.00\nf* = 0.70/2.00 – 0.30/0.50 = 0.350 – 0.600 = –0.250\n→ Negative! Never bet! [X]\nEven at 70% win rate, excessive leverage turns this into an unfavorable game.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#dc2626",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 505668,
      "version": 1,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "baseline": 16,
      "originalText": "Example 2: Win 70%, +50% on win, –200% on loss (2× leverage!)\n\np = 0.70, q = 0.30, b = 0.50, a = 2.00\nf* = 0.70/2.00 – 0.30/0.50 = 0.350 – 0.600 = –0.250\n→ Negative! Never bet! [X]\nEven at 70% win rate, excessive leverage turns this into an unfavorable game."
    },
